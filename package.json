{
  "name": "figma-tokens-nuxt-ui-adapter",
  "version": "0.59.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "build:tokens": "tsx scripts/build-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "vue-tsc -b && tsc -p tsconfig.scripts.json",
    "extract-tailwind-defaults": "node scripts/extract-tailwind-defaults.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxt/ui": "^4.0.0",
    "@stackblitz/sdk": "1.11.0",
    "vue": "^3.5.0",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@tailwindcss/browser": "4.3.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/coverage-v8": "2.1.9",
    "@vue/test-utils": "2.4.10",
    "@vue/tsconfig": "^0.7.0",
    "husky": "^9.1.7",
    "jsdom": "25.0.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.2.0"
  }
}
