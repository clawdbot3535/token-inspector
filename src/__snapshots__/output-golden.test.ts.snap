exports[`output golden master (canonical components/ tokens) > stable: nuxt/custom-components.ts 1`] = `
"// Generated by build-cli — recipes Nuxt UI cannot express natively:
// custom components (foreign parts Nuxt has no slot for) AND overlay-surface
// overrides (component appearance on a dark/light overlay — no Nuxt prop exists).
// Hand-apply via tailwind-variants: const ui = tv(chipRecipe) / tv(base, buttonOverlayDarkRecipe).

export const chipRecipe = {
  slots: {
    base: "active:bg-[var(--color-action-bg-subtle)] active:ring-[var(--color-action-bg)] bg-[var(--color-bg-muted)] disabled:bg-[var(--color-state-disabled-bg)] disabled:ring-[var(--color-state-disabled-border)] font-[500] gap-1.5 hover:bg-[var(--color-bg-emphasis)] leading-[8px] px-0.5 py-0.5 ring-[var(--color-border-default)] ring-offset-[2px] rounded-[999px] text-[8px] tracking-[0.4000000059604645px]",
    close: "size-3",
    label: "active:text-[var(--color-action-text-subtle)] disabled:text-[var(--color-state-disabled-text)] text-[var(--color-text-secondary)]",
  },
  variants: {
    color: {
      error: {
        base: "bg-[var(--color-status-error-bg)] ring-[var(--color-status-error-border)]",
        label: "text-[var(--color-status-error-text)]",
      },
      success: {
        base: "bg-[var(--color-status-ok-bg)] ring-[var(--color-status-ok-border)]",
        label: "text-[var(--color-status-ok-text)]",
      },
    },
  },
} as const;
"
`;

