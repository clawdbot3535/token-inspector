        <h2 class="text-sm font-semibold capitalize">dropdown</h2>
        <div class="flex flex-wrap items-center gap-3"><UDropdownMenu :items="[[{ label: 'Item' }]]"><UButton>Open menu</UButton></UDropdownMenu></div>
      </section>
      <section data-component="table" class="space-y-2">
        <h2 class="text-sm font-semibold capitalize">table</h2>
        <div class="flex flex-wrap items-center gap-3"><UTable :data="[{ id: 1, name: 'Row 1' }, { id: 2, name: 'Row 2' }]" /></div>
      </section>
      <section data-component="progress" class="space-y-2">
        <h2 class="text-sm font-semibold capitalize">progress</h2>
        <div class="flex flex-wrap items-center gap-3"><UProgress :model-value="50" /></div>
      </section>
    </main>
  </UApp>
</template>
"
`;

