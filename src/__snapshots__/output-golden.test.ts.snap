  --color-red-alpha-500-10: rgba(239, 68, 68, 0.1);
  --color-transparent: rgba(0, 0, 0, 0);
  --color-white: #FFFFFF;
  --shadow-focus: 0 0 0 3px rgba(79,99,210,0.35);
  --shadow-lg: 0 12px 20px -4px rgba(0,0,0,0.10), 0 4px 8px -4px rgba(0,0,0,0.06);
  --shadow-md: 0 4px 8px -2px rgba(0,0,0,0.10), 0 2px 4px -2px rgba(0,0,0,0.06);
  --shadow-sm: 0 1px 3px -1px rgba(0,0,0,0.08), 0 1px 2px -1px rgba(0,0,0,0.04);
  --shadow-xl: 0 20px 32px -6px rgba(0,0,0,0.12), 0 8px 12px -4px rgba(0,0,0,0.08);

  /* — Mode-invariant Brand Colors — */
  /* mode-invariant: same in light + dark */
  --color-action-bg: #4F63D2;
  /* mode-invariant: same in light + dark */
  --color-action-text: #FFFFFF;
  /* mode-invariant: same in light + dark */
