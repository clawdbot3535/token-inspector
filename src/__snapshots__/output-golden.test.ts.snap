  /* mode-invariant: same in light + dark */
  --color-text-on-accent: #FFFFFF;

  /* — Non-default Radius — */
  --rounded-full: 999px;

  /* — Non-default Typography — */
  --font-family-body: Geist;
  --font-family-code: "Fira Sans";
  --font-family-display: "Google Sans Flex";
  --font-family-kbd: "SF Pro";
  --font-size-text-2xs: 8px;
