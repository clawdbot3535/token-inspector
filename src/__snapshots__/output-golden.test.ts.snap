/* Dark mode overrides */
.dark {
  --color-action-bg-active: #A5B4FC;
  --color-action-bg-hover: #818CF8;
  --color-action-bg-subtle: #1A245E;
  --color-action-bg-subtle-hover: #243092;
  --color-action-text-subtle: #818CF8;
  --color-bg-base: #09090B;
  --color-bg-elevated: #18181B;
  --color-bg-emphasis: #52525B;
  --color-bg-muted: #3F3F46;
  --color-bg-subtle: #27272A;
  --color-border-accent: #3D50BE;
  --color-border-default: #3F3F46;
  --color-border-error: #DC2626;
  --color-border-strong: #71717A;
  --color-border-subtle: #27272A;
  --color-border-success: #16A34A;
  --color-border-warning: #D97706;
  --color-state-active-overlay: #FFFFFF;
  --color-state-disabled-bg: #27272A;
  --color-state-disabled-border: #3F3F46;
  --color-state-disabled-fg: #52525B;
  --color-state-disabled-text: #52525B;
  --color-state-focus-ring: #A5B4FC;
  --color-state-hover-overlay: #FFFFFF;
  --color-state-loading-bg: #27272A;
  --color-state-selected-bg: #1A245E;
  --color-state-selected-border: #2E3EA8;
  --color-state-selected-text: #A5B4FC;
  --color-status-error-bg: #EF4444;
  --color-status-error-border: #B91C1C;
  --color-status-error-text: #FEF2F2;
  --color-status-ok-bg: #22C55E;
  --color-status-ok-border: #15803D;
  --color-status-ok-text: #F0FDF4;
  --color-status-warn-bg: #F59E0B;
  --color-status-warn-border: #B45309;
  --color-status-warn-text: #FFFBEB;
  --color-text-accent: #818CF8;
  --color-text-disabled: #3F3F46;
  --color-text-inverted: #18181B;
  --color-text-muted: #52525B;
  --color-text-primary: #FAFAFA;
  --color-text-secondary: #A1A1AA;
  --color-text-toned: #71717A;
}
"
`;

exports[`output golden master (canonical components/ tokens) > stable: kit/vite.config.ts 1`] = `
"import { defineConfig } from "vite";
import vue from "@vitejs/plugin-vue";
import tailwindcss from "@tailwindcss/vite";
import ui from "@nuxt/ui/vite";
import { theme } from "./theme";

export default defineConfig({
  plugins: [vue(), tailwindcss(), ui({ ui: theme })],
});
"
`;

