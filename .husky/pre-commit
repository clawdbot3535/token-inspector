#!/usr/bin/env sh
# Pre-commit gate: a subset of the GitHub Actions CI checks
# (.github/workflows/ci.yml) — typecheck + tests. CI additionally runs the
# full build and the token-pipeline CLI. Catches TS strict-mode regressions
# (vue-tsc -b across app + node + scripts) and broken tests before they leave
# the local machine.

set -e

echo "→ vue-tsc typecheck…"
npm run typecheck --silent

echo "→ vitest…"
npm test --silent

echo "✓ pre-commit checks passed"
